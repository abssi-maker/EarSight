# EarSight environment variables
# Copy to .env and fill in your values. Never commit .env.

# Google Cloud / Gemini
# --- Production (Cloud Run) ---
# Set GOOGLE_CLOUD_PROJECT to use Vertex AI + ADC (service account, no key needed).
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1   # optional, defaults to us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # local dev only
#
# --- Local development ---
# Leave GOOGLE_CLOUD_PROJECT unset and provide the API key below instead.
GOOGLE_API_KEY=your-gemini-api-key-here
# GEMINI_API_KEY is an alias accepted by the synthesiser; prefer GOOGLE_API_KEY.

# Google Cloud Storage
GCS_BUCKET=earsight-media

# Confluent Kafka (Cloud Run services use these)
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east1.gcp.confluent.cloud:9092
CONFLUENT_API_KEY=your-confluent-api-key
CONFLUENT_API_SECRET=your-confluent-api-secret

# Service URLs (set by Cloud Run; for local dev, use localhost)
ORCHESTRATOR_URL=http://localhost:8000
TRANSCRIBER_URL=http://localhost:8001
FRAMER_URL=http://localhost:8002
DESCRIBER_URL=http://localhost:8003
SYNTHESISER_URL=http://localhost:8004
MIXER_URL=http://localhost:8005

# Demo / development flags
EARSIGHT_USE_CACHE=0   # Set to 1 to use cached model responses for demo clip
